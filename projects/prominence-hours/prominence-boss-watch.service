[Unit]
Description=Prominence boss spawn/defeat -> Discord broadcaster
After=network-online.target prominence-hours-tracker.service
Wants=network-online.target

[Service]
Type=simple
User=<USERNAME_REDACTED>
Group=<USERNAME_REDACTED>
WorkingDirectory=/home/<USERNAME_REDACTED>/prominence-hours
ExecStart=/home/<USERNAME_REDACTED>/jarvis-discord-relay/.venv/bin/python /home/<USERNAME_REDACTED>/prominence-hours/boss_watch.py
Restart=on-failure
RestartSec=15
Environment=VELOCITY_DISCORD_CONFIG=/data/compose/13/docker/servers/43ac65de-795f-443f-9cc5-2aecc7447a05/plugins/discord/config.toml
Environment=DAMAGE_DB=/data/compose/13/docker/servers/50a6d163-0309-4832-986f-106668768b3d/prominence-damage/damage.db
Environment=BOSS_WATCH_STATE=/home/<USERNAME_REDACTED>/prominence-hours/boss-watch-state.json
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/<USERNAME_REDACTED>/prominence-hours
ReadOnlyPaths=/data/compose/13/docker/servers/43ac65de-795f-443f-9cc5-2aecc7447a05/plugins/discord/config.toml /data/compose/13/docker/servers/50a6d163-0309-4832-986f-106668768b3d/prominence-damage
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
